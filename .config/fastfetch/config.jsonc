// Catppuccin Mocha - Hittake Cappu Theme

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/hittake/.config/fastfetch/lantern.txt",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2,
    },
    "color": {
      "1": "#cba6f7",
      "2": "#cba6f7",
      "3": "#cba6f7",
      "4": "#cba6f7",
      "5": "#cba6f7",
    },
  },
  "display": {
    "separator": " \u001b[38;2;203;166;247m\u001b[0m ",
    "constants": ["\u001b[38;2;137;180;250m─────────────────\u001b[0m"],
    "key": {
      "type": "icon",
      "paddingLeft": 2,
    },
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#cba6f7",
        "at": "#89b4fa",
        "host": "#94e2d5",
      },
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;137;180;250m┌\u001b[0m{$1} \u001b[38;2;203;166;247mHardware Information\u001b[0m {$1}\u001b[38;2;137;180;250m┐\u001b[0m",
    },
    {
      "type": "host",
      "keyColor": "#89b4fa",
    },
    {
      "type": "cpu",
      "keyColor": "#f38ba8",
    },
    {
      "type": "gpu",
      "keyColor": "#fab387",
    },
    {
      "type": "disk",
      "keyColor": "#f9e2af",
    },
    {
      "type": "memory",
      "keyColor": "#a6e3a1",
    },
    {
      "type": "swap",
      "keyColor": "#a6e3a1",
    },
    {
      "type": "battery",
      "keyColor": "#94e2d5",
    },
    {
      "type": "display",
      "keyColor": "#89b4fa",
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;137;180;250m└\u001b[0m{$1}\u001b[38;2;137;180;250m──────────────────────\u001b[0m{$1}\u001b[38;2;137;180;250m┘\u001b[0m",
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;137;180;250m┌\u001b[0m{$1} \u001b[38;2;203;166;247mSoftware Information\u001b[0m {$1}\u001b[38;2;137;180;250m┐\u001b[0m",
    },
    {
      "type": "os",
      "keyColor": "#89b4fa",
    },
    {
      "type": "kernel",
      "keyColor": "#cba6f7",
    },
    {
      "type": "lm",
      "keyColor": "#f5c2e7",
    },
    {
      "type": "wm",
      "keyColor": "#b4befe",
    },
    {
      "type": "shell",
      "keyColor": "#89b4fa",
    },
    {
      "type": "terminal",
      "keyColor": "#94e2d5",
    },
    {
      "type": "theme",
      "keyColor": "#f5c2e7",
    },
    {
      "type": "icons",
      "keyColor": "#fab387",
    },
    {
      "type": "packages",
      "keyColor": "#f9e2af",
    },
    {
      "type": "uptime",
      "keyColor": "#a6e3a1",
    },
    {
      "type": "locale",
      "keyColor": "#89b4fa",
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;137;180;250m└\u001b[0m{$1}\u001b[38;2;137;180;250m──────────────────────\u001b[0m{$1}\u001b[38;2;137;180;250m┘\u001b[0m",
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 21,
    },
  ],
}
